# Candy Shop — single source of env config for every component
# (robot, operators, teleoperator, voice-agent).
#
# Copy to `.env` and fill in. `.env.local` overrides `.env` if present.
# All components load this root file, so you only maintain it here.

# ── LiveKit (required everywhere) ────────────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=candy-shop

# ── General ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Robot / SO-101 follower (leslider) ───────────────────────────────────────
LESLIDER_ID=leslider
LESLIDER_PORT=/dev/ttyACM0
LESLIDER_SLIDER_ID=7
LESLIDER_SLIDER_MAX_VELOCITY=3000
LESLIDER_CAM_WIDTH=640
LESLIDER_CAM_HEIGHT=480
# Camera index (macOS) or /dev/videoN path (Linux)
LESLIDER_CAM_ARM=/dev/video0
LESLIDER_CAM_OVERHEAD=/dev/video2

# ── Teleoperator (SO-101 leader + slider recorder) ───────────────────────────
TELEOPERATOR_IDENTITY=teleoperator
TELEOP_CRUISE_VELOCITY=1500
TELEOP_MAX_VELOCITY=3000
PORTAL_FPS=30
SO101_LEADER_ID=so101_leader
SO101_LEADER_PORT=
# Optional dataset recording
DATASET_REPO_ID=
DATASET_ROOT=
DATASET_TASK=
# Optional: override wire contract path (defaults to repo-root portal.yaml)
# PORTAL_CONFIG=
# Mimic: the leader mirrors the arm while another operator drives it, and a push on the
# leader takes over. Seconds to ease onto the arm's pose when torque comes on; the gap
# (degrees, and % on the gripper) that counts as a push, and how long it must hold;
# leader holding torque in per mille (500 = half, enough to hold itself and still yield).
TELEOP_MIMIC_ALIGN_S=1.5
TELEOP_MIMIC_INTERVENE_DEG=10
TELEOP_MIMIC_INTERVENE_GRIPPER=20
TELEOP_MIMIC_HOLD_S=0.2
TELEOP_MIMIC_TORQUE_LIMIT=500

# ── Teleoperator review UI ───────────────────────────────────────────────────
TELEOPERATOR_UI_IDENTITY=teleoperator-ui
TELEOPERATOR_UI_TARGET=
TELEOPERATOR_UI_POLL_HZ=4

# ── move-to operator ─────────────────────────────────────────────────────────
# (uses LiveKit vars above; no extra config)

# ── Policy operator ──────────────────────────────────────────────────────────
# Required (or pass --checkpoint): a SmolVLA fine-tune dir or Hub repo id.
POLICY_CHECKPOINT=
POLICY_TASK=pick up the candy
POLICY_DEVICE=cuda
POLICY_DURATION_S=0
POLICY_NUM_STEPS=0
POLICY_SETTLE_TOLERANCE=2.0
POLICY_SETTLE_TIMEOUT_S=2.0
POLICY_PRIMARY_CAMERA=overhead_camera
POLICY_WRIST_CAMERA=arm_camera

# ── Reward (SARM) operator ───────────────────────────────────────────────────
REWARD_CHECKPOINT=
REWARD_TASK=pick up the candy
REWARD_CAMERA=overhead_camera
REWARD_DEVICE=cuda
REWARD_THRESHOLD=0.99
REWARD_HOLD_S=1.0
# One time budget per attempt; a spent budget restarts the policy, which refolds
# to the rest pose before trying again.
REWARD_ATTEMPT_BUDGETS=15,20,25
# Overall cap across all attempts (0 = uncapped). Above the budgets plus a pause
# and an unwind each, and below the agent's RUN_TASK_TIMEOUT_S minus twice the
# policy timeout below — otherwise the agent abandons the RPC mid-motion.
REWARD_TIMEOUT_S=90
REWARD_EVAL_INTERVAL_S=1.0
# Hang guard on the stop RPC and the policy unwind, not a budget: the policy
# checks the stop flag every tick, so a healthy unwind is under a second.
REWARD_POLICY_TIMEOUT_S=10
REWARD_RETRY_PAUSE_S=1.0
